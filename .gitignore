# js/config.js É versionado: contém apenas URL + anon key (públicas por
# natureza, protegidas por RLS). A service_role NUNCA entra aqui (regra 10).

# Segredos/serviços do Supabase (a service_role jamais é versionada).
.env
.env.*
supabase/.env
supabase/.temp/

# SQL gerado pelas migrações de planilha: contém dados reais (inclusive
# nomes de servidores) e o repositório é público. Versionamos só os
# conversores, em scripts/.
migracao_licitacoes_dados.sql
migracao_subped_dados.sql
migracao_subped_dados_conferencia.sql

# Sistema
.DS_Store
Thumbs.db

# Scripts de banco: NUNCA versionados (regra permanente da rede — o
# repositório é público e todo arquivo commitado vira URL baixável).
# Eles moram em db/ no disco de quem trabalha e são rodados no SQL Editor
# do Supabase. Ver sql/LEIA-ME.md.
db/
*.sql
